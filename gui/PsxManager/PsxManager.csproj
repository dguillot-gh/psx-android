<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PSX-Manager</AssemblyName>
    <RootNamespace>PsxManager</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PSX Manager</Product>
    <Description>Front end for the psx-android pipeline: build PS1 recomps for Android, put them on the phone, see what's happening.</Description>
    <!-- Published self-contained (own .NET runtime) as one exe: see ..\build-manager.ps1 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
